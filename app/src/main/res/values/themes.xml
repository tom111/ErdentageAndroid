<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Erdentage" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.Erdentage.DatePicker" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:datePickerStyle">@style/Widget.Erdentage.DatePicker</item>
    </style>

    <style name="Widget.Erdentage.DatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
    </style>
</resources>
